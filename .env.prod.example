# Na VPS wystarczy `docker compose up -d --build`, bez wypisywania -f.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# IP lub domena VPS, po przecinku
DJANGO_ALLOWED_HOSTS=
# Te same adresy, ale z protokołem, np. http://1.2.3.4
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=zerorisk
POSTGRES_USER=zerorisk
# Wygeneruj tak samo jak klucz Django
POSTGRES_PASSWORD=
