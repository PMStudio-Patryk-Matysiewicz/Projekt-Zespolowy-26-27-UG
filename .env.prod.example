# Na VPS wystarczy `docker compose up -d --build`, bez wypisywania -f.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Domena z certyfikatem Let's Encrypt, np. zerorisk.westeurope.cloudapp.azure.com
DOMAIN=
# Ta sama domena (można dopisać po przecinku inne)
DJANGO_ALLOWED_HOSTS=
# Ta sama domena z https://, np. https://zerorisk.westeurope.cloudapp.azure.com
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=zerorisk
POSTGRES_USER=zerorisk
# Wygeneruj tak samo jak klucz Django
POSTGRES_PASSWORD=
