server {
    listen 80;
    server_name _;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # Let's Encrypt certificate from the host (certbot, docs/docker.md), mounted read-only.
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    client_max_body_size 10m;

    # Django's address is looked up on every request (Docker DNS), so after the backend
    # container is rebuilt nginx does not keep its old IP and needs no restart.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend http://backend:8000;

    # API, admin panel and Django's static files (served by whitenoise) go to Django.
    location ~ ^/(api|admin|static)/ {
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite puts a content hash in every asset name, so assets can be cached for a year.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Any other path belongs to React Router: send index.html and let the app pick the page.
    # no-cache makes the browser fetch a fresh index.html after every deploy.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
