# Wszystkie zmienne, które czyta ZeroRisk. Wszystkie są zakomentowane i bez haseł.
#
# Lokalnie .env NIE jest potrzebny: wartości deweloperskie są w compose.override.yaml.
# Jeśli chcesz coś nadpisać, skopiuj ten plik do .env i odkomentuj tylko potrzebne linie.
# Na VPS użyj wzoru .env.prod.example (patrz docs/docker.md).

# --- Compose -------------------------------------------------------------------
# Tylko na VPS: compose.yaml + compose.prod.yaml bez podawania -f.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Tylko lokalnie (Linux / podman): właściciel plików tworzonych w kontenerze.
# LOCAL_UID=1000
# LOCAL_GID=1000

# Tylko lokalnie: port backendu, gdy 8000 jest zajęty.
# BACKEND_PORT=8000

# Skrót commita widoczny w GET /api/health. Wdrożenie ustawia go samo; lokalnie "dev".
# GIT_SHA=dev

# --- Django --------------------------------------------------------------------
# Wymagany, gdy DJANGO_DEBUG=0. Generowanie:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# 1 = tryb deweloperski, 0 = produkcja
# DJANGO_DEBUG=0

# Hosty po przecinku, np. zerorisk.westeurope.cloudapp.azure.com,1.2.3.4
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Te same adresy z protokołem, np. https://zerorisk.westeurope.cloudapp.azure.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ----------------------------------------------------------------
# W Dockerze POSTGRES_HOST=db (ustawia compose.yaml).
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=zerorisk
# POSTGRES_USER=zerorisk
# Generowanie jak DJANGO_SECRET_KEY
# POSTGRES_PASSWORD=
