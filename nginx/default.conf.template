server {
    listen 80;
    server_name _;

    # Adres backendu rozwiązywany przy każdym żądaniu (DNS Dockera), więc po
    # przebudowie kontenera backend nginx nie trzyma starego IP i nie trzeba go restartować.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend http://backend:8000;

    client_max_body_size 10m;

    # Na razie cały ruch idzie do Django. Gdy powstanie frontend (React), nginx będzie
    # serwował jego zbudowane pliki, a do Django przekaże tylko /api/, /admin/ i /static/.
    location / {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
